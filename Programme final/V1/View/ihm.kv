#: kivy 2.1.0
# View/ihm.kv
# ─────────────────────────────────────────────────────────────────────────────
# Mise en page complète de l'IHM.
# Les propriétés Kivy définies en Python sont bindées automatiquement :
#   root → widget courant (AccueilScreen, SeuilsScreen, etc.)
#   app  → instance IHM (App) → app.seuil_vert, app.seuil_orange,
#                                app.seuil_tvoc_vert, app.seuil_tvoc_orange,
#                                app.seuil_co2_vert,  app.seuil_co2_orange
# ─────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# ECRAN 1 – Accueil PM10
# Fond coloré selon le seuil actif, horloge temps réel.
# ══════════════════════════════════════════════════════════════════════════════
<AccueilScreen>:
    canvas.before:
        Color:
            rgba: 0.82, 0.82, 0.82, 1
        Rectangle:
            pos:  self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding:  [6, 6, 6, 4]
        spacing:  5

        # En-tête : titre a gauche, horloge a droite
        BoxLayout:
            orientation: 'horizontal'
            size_hint:   1, None
            height:      24

            Label:
                text:      "[b]Taux de particules dans l'air[/b]"
                markup:    True
                font_size: '12sp'
                halign:    'left'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1
                size_hint: 0.60, 1

            # Horloge mise a jour chaque seconde via root.time_text
            Label:
                text:      root.time_text
                font_size: '12sp'
                halign:    'right'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1
                size_hint: 0.40, 1

        # Bloc mesure : fond coloré (root.pm10_color) et texte centré
        BoxLayout:
            orientation: 'vertical'
            padding:     [16, 0, 16, 0]

            canvas.before:
                Color:
                    rgba: root.pm10_color
                Rectangle:
                    pos:  self.pos
                    size: self.size

            # Valeur en grand (34sp) + état en plus petit (15sp)
            Label:
                markup:    True
                text:
                    '[size=34sp][b]' + root.val_text + '[/b][/size]\n' \
                    + '[size=15sp]' + root.state_text + '[/size]'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1


# ══════════════════════════════════════════════════════════════════════════════
# ECRAN 2 – Seuils PM10
# Les valeurs sont bindées sur app.seuil_vert / app.seuil_orange et se
# mettent a jour automatiquement si le broker MQTT envoie de nouveaux seuils.
# ══════════════════════════════════════════════════════════════════════════════
<SeuilsScreen>:
    canvas.before:
        Color:
            rgba: 0.82, 0.82, 0.82, 1
        Rectangle:
            pos:  self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding:     8
        spacing:     8

        Label:
            text:      '[b]Seuils PM10 configures[/b]'
            markup:    True
            font_size: '15sp'
            color:     0, 0, 0, 1
            size_hint: 1, None
            height:    28
            halign:    'center'
            valign:    'middle'
            text_size: self.size

        # Seuil vert
        BoxLayout:
            size_hint: 1, None
            height:    55
            padding:   8
            canvas.before:
                Color:
                    rgba: 0.13, 0.86, 0.13, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:      '[b]Seuil 1 - Vert[/b]\nPM10 < ' + str(int(app.seuil_vert)) + ' ug/m3'
                font_size: '13sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        # Seuil orange
        BoxLayout:
            size_hint: 1, None
            height:    55
            padding:   8
            canvas.before:
                Color:
                    rgba: 1.0, 0.60, 0.0, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:
                    '[b]Seuil 2 - Orange[/b]\nPM10  ' \
                    + str(int(app.seuil_vert)) + ' - ' \
                    + str(int(app.seuil_orange)) + ' ug/m3'
                font_size: '13sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        # Seuil rouge
        BoxLayout:
            size_hint: 1, None
            height:    55
            padding:   8
            canvas.before:
                Color:
                    rgba: 0.95, 0.15, 0.15, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:      '[b]Seuil 3 - Rouge[/b]\nPM10 >= ' + str(int(app.seuil_orange)) + ' ug/m3'
                font_size: '13sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        Label:
            text:      '[i]Retour auto dans 60 s   (bouton A = basculer)[/i]'
            markup:    True
            font_size: '10sp'
            color:     0.35, 0.35, 0.35, 1
            size_hint: 1, None
            height:    16
            halign:    'center'
            valign:    'middle'
            text_size: self.size


# ══════════════════════════════════════════════════════════════════════════════
# ECRAN 3 – Configuration réseau
# root.ip_text et root.mac_text sont mis a jour en arrière-plan (on_enter).
# ══════════════════════════════════════════════════════════════════════════════
<ReseauScreen>:
    canvas.before:
        Color:
            rgba: 0.82, 0.82, 0.82, 1
        Rectangle:
            pos:  self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding:     8
        spacing:     10

        Label:
            text:      '[b]Configuration reseau[/b]'
            markup:    True
            font_size: '15sp'
            color:     0, 0, 0, 1
            size_hint: 1, None
            height:    28
            halign:    'center'
            valign:    'middle'
            text_size: self.size

        # Bloc adresse IP
        BoxLayout:
            orientation: 'vertical'
            size_hint:   1, None
            height:      72
            padding:     10
            canvas.before:
                Color:
                    rgba: 0.35, 0.35, 0.35, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                text:      'Adresse IP'
                font_size: '12sp'
                bold:      True
                color:     1, 1, 1, 1
                halign:    'center'
                valign:    'middle'
                text_size: self.size
            Label:
                text:      root.ip_text
                font_size: '15sp'
                color:     1, 1, 1, 1
                halign:    'center'
                valign:    'middle'
                text_size: self.size

        # Bloc adresse MAC
        BoxLayout:
            orientation: 'vertical'
            size_hint:   1, None
            height:      72
            padding:     10
            canvas.before:
                Color:
                    rgba: 0.35, 0.35, 0.35, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                text:      'Adresse MAC'
                font_size: '12sp'
                bold:      True
                color:     1, 1, 1, 1
                halign:    'center'
                valign:    'middle'
                text_size: self.size
            Label:
                text:      root.mac_text
                font_size: '15sp'
                color:     1, 1, 1, 1
                halign:    'center'
                valign:    'middle'
                text_size: self.size

        Label:
            text:      '[i]Retour auto dans 60 s   (bouton B = basculer)[/i]'
            markup:    True
            font_size: '10sp'
            color:     0.35, 0.35, 0.35, 1
            size_hint: 1, None
            height:    16
            halign:    'center'
            valign:    'middle'
            text_size: self.size


# ══════════════════════════════════════════════════════════════════════════════
# ECRAN 4 – Accueil TVOC + CO2
# Deux blocs colorés empilés, un par capteur.
# Note : "CO2" sans exposant pour compatibilité d'affichage sur UNIHIKER.
# ══════════════════════════════════════════════════════════════════════════════
<AccueilCapteur2Screen>:
    canvas.before:
        Color:
            rgba: 0.82, 0.82, 0.82, 1
        Rectangle:
            pos:  self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding:  [6, 6, 6, 4]
        spacing:  5

        # En-tête
        BoxLayout:
            orientation: 'horizontal'
            size_hint:   1, None
            height:      24

            Label:
                text:      '[b]Qualite de l\'air interieur[/b]'
                markup:    True
                font_size: '12sp'
                halign:    'left'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1
                size_hint: 0.60, 1

            Label:
                text:      root.time_text
                font_size: '12sp'
                halign:    'right'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1
                size_hint: 0.40, 1

        # Bloc TVOC — root.tvoc_color selon app.seuil_tvoc_*
        BoxLayout:
            orientation: 'vertical'
            padding:     [16, 0, 16, 0]

            canvas.before:
                Color:
                    rgba: root.tvoc_color
                Rectangle:
                    pos:  self.pos
                    size: self.size

            Label:
                markup:    True
                text:
                    '[size=18sp][b]TVOC[/b][/size]\n' \
                    + '[size=30sp][b]' + root.tvoc_val_text + '[/b][/size]\n' \
                    + '[size=13sp]' + root.tvoc_state_text + '[/size]'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        # Bloc CO2 — root.co2_color selon app.seuil_co2_*
        # "CO2" en texte normal, pas de caractère exposant
        BoxLayout:
            orientation: 'vertical'
            padding:     [16, 0, 16, 0]

            canvas.before:
                Color:
                    rgba: root.co2_color
                Rectangle:
                    pos:  self.pos
                    size: self.size

            Label:
                markup:    True
                text:
                    '[size=18sp][b]CO2[/b][/size]\n' \
                    + '[size=30sp][b]' + root.co2_val_text + '[/b][/size]\n' \
                    + '[size=13sp]' + root.co2_state_text + '[/size]'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1


# ══════════════════════════════════════════════════════════════════════════════
# ECRAN 5 – Seuils TVOC + CO2
# Deux séries de seuils, une par capteur.
# ══════════════════════════════════════════════════════════════════════════════
<SeuilsCapteur2Screen>:
    canvas.before:
        Color:
            rgba: 0.82, 0.82, 0.82, 1
        Rectangle:
            pos:  self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding:     8
        spacing:     5

        Label:
            text:      '[b]Seuils TVOC & CO2[/b]'
            markup:    True
            font_size: '15sp'
            color:     0, 0, 0, 1
            size_hint: 1, None
            height:    26
            halign:    'center'
            valign:    'middle'
            text_size: self.size

        # Section TVOC
        Label:
            text:      '[b]-- TVOC (ppb) --[/b]'
            markup:    True
            font_size: '12sp'
            color:     0.25, 0.25, 0.25, 1
            size_hint: 1, None
            height:    18
            halign:    'center'
            text_size: self.size

        BoxLayout:
            size_hint: 1, None
            height:    38
            padding:   6
            canvas.before:
                Color:
                    rgba: 0.13, 0.86, 0.13, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:      '[b]Vert[/b]  TVOC < ' + str(int(app.seuil_tvoc_vert)) + ' ppb'
                font_size: '12sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        BoxLayout:
            size_hint: 1, None
            height:    38
            padding:   6
            canvas.before:
                Color:
                    rgba: 1.0, 0.60, 0.0, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:
                    '[b]Orange[/b]  TVOC ' \
                    + str(int(app.seuil_tvoc_vert)) + ' - ' \
                    + str(int(app.seuil_tvoc_orange)) + ' ppb'
                font_size: '12sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        BoxLayout:
            size_hint: 1, None
            height:    38
            padding:   6
            canvas.before:
                Color:
                    rgba: 0.95, 0.15, 0.15, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:      '[b]Rouge[/b]  TVOC >= ' + str(int(app.seuil_tvoc_orange)) + ' ppb'
                font_size: '12sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        # Section CO2
        Label:
            text:      '[b]-- CO2 (ppm) --[/b]'
            markup:    True
            font_size: '12sp'
            color:     0.25, 0.25, 0.25, 1
            size_hint: 1, None
            height:    18
            halign:    'center'
            text_size: self.size

        BoxLayout:
            size_hint: 1, None
            height:    38
            padding:   6
            canvas.before:
                Color:
                    rgba: 0.13, 0.86, 0.13, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:      '[b]Vert[/b]  CO2 < ' + str(int(app.seuil_co2_vert)) + ' ppm'
                font_size: '12sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        BoxLayout:
            size_hint: 1, None
            height:    38
            padding:   6
            canvas.before:
                Color:
                    rgba: 1.0, 0.60, 0.0, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:
                    '[b]Orange[/b]  CO2 ' \
                    + str(int(app.seuil_co2_vert)) + ' - ' \
                    + str(int(app.seuil_co2_orange)) + ' ppm'
                font_size: '12sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        BoxLayout:
            size_hint: 1, None
            height:    38
            padding:   6
            canvas.before:
                Color:
                    rgba: 0.95, 0.15, 0.15, 1
                Rectangle:
                    pos:  self.pos
                    size: self.size
            Label:
                markup:    True
                text:      '[b]Rouge[/b]  CO2 >= ' + str(int(app.seuil_co2_orange)) + ' ppm'
                font_size: '12sp'
                halign:    'center'
                valign:    'middle'
                text_size: self.size
                color:     0, 0, 0, 1

        Label:
            text:      '[i]Retour auto dans 60 s[/i]'
            markup:    True
            font_size: '10sp'
            color:     0.35, 0.35, 0.35, 1
            size_hint: 1, None
            height:    14
            halign:    'center'
            text_size: self.size


# ══════════════════════════════════════════════════════════════════════════════
# POPUP — overlay semi-transparent centré par-dessus tout écran
# opacity est bindé sur is_visible : 1 = visible, 0 = invisible.
# ══════════════════════════════════════════════════════════════════════════════
<PopupOverlay>:
    opacity: 1 if self.is_visible else 0

    canvas.before:
        Color:
            rgba: 0.10, 0.10, 0.10, 0.88
        RoundedRectangle:
            pos:    self.pos
            size:   self.size
            radius: [12]

    BoxLayout:
        orientation: 'vertical'
        padding:     [14, 10, 14, 10]
        spacing:     6

        # Titre de l'alerte en rouge clair
        Label:
            text:      root.titre
            font_size: '13sp'
            bold:      True
            color:     1.0, 0.4, 0.4, 1
            halign:    'center'
            valign:    'middle'
            text_size: self.size

        # Message détaillé en blanc
        Label:
            text:      root.message
            font_size: '11sp'
            color:     1, 1, 1, 1
            halign:    'center'
            valign:    'middle'
            text_size: self.size
